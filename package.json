{
    "name": "spatial-task-graph",
    "version": "1.1.5",
    "description": "Visualize markdown tasks on an infinite canvas with auto-layout, mind-map style connections, Apple-style UI, and two-way sync.",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "test": "node scripts/test-tasknotes-adapter.mjs",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint ."
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "task-management",
        "spatial-canvas",
        "mind-map"
    ],
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "9.30.1",
        "@types/node": "^16.11.6",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^8.35.1",
        "@typescript-eslint/parser": "^8.35.1",
        "esbuild": "0.25.5",
        "eslint": "^9.39.3",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "globals": "14.0.0",
        "jiti": "2.6.1",
        "obsidian": "latest",
        "tslib": "2.4.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.35.1"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "reactflow": "^11.11.4"
    }
}
